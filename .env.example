# GarageAI Environment Variables
# Copy this file to .env and fill in your values

# Google Gemini API Key (required)
# Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Twilio (optional, for phone integration)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Database (defaults to local Docker container)
WINCAR_DB_CONNECTION=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost;DATABASE=WinCarLive;UID=sa;PWD=StrongPassword123!
WINCAR_DB_MASTER_CONNECTION=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost;DATABASE=master;UID=sa;PWD=StrongPassword123!;Connection Timeout=3

# CORS (production frontend Cloud Run URL)
CORS_ORIGIN=https://garageai-dashboard-xxx-ew.a.run.app

# Deepgram STT (required for voice calls)
# Get yours at: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ElevenLabs Voice Synthesis (required)
# Get yours at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Background office noise volume (0.0 = silent, 1.0 = full, default 0.03)
OFFICE_NOISE_VOLUME=0.03

# LangSmith (optional, for tracing)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=GarageAI
