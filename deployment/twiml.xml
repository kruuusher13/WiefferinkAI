<?xml version="1.0" encoding="UTF-8"?>
<!-- 
    TwiML for GarageAI
    Copy this into a Twilio TwiML Bin.
    
    Replace {{YOUR_SERVER_DOMAIN}} with your actual Cloud Run or Ngrok domain.
    Do NOT include 'https://' or 'wss://' in the variable if using the format below,
    or simply paste the full wss:// URL directly.
-->
<Response>
    <Connect>
        <Stream url="wss://{{YOUR_SERVER_DOMAIN}}/ws/twilio" />
    </Connect>
</Response>
